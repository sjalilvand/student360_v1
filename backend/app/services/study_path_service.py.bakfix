# app/services/study_path_service.py
# Personalized Study Path (Phase 2 / category 2: STU-CRS scenarios).
# Schema-adaptive over stu_curriculum. Plan is advisory only (STU-CRS-11).
# Risk-aware unit cap: connects risk_service -> conservative path.
from __future__ import annotations

import json

from sqlalchemy import inspect as sa_inspect, text
from sqlalchemy.orm import Session

from app.services import event_tracking_service as ets
from app.services import risk_service as rs

DISCLAIMER = ("⚠️ این مسیر صرفاً پیشنهاد اولیه است و جایگزین سامانه رسمی آموزش نیست "
              "(STU-CRS-11)؛ ثبت قطعی فقط در سامانه آموزش انجام می‌شود.")

_PERSIAN_DIGITS = str.maketrans("0123456789", "۰۱۲۳۴۵۶۷۸۹")


def _fa(n) -> str:
    return str(n).translate(_PERSIAN_DIGITS)


def _cols(db: Session, table: str):
    try:
        return [c["name"] for c in sa_inspect(db.bind).get_columns(table)]
    except Exception:
        return []


def _pick(cols: list, candidates: tuple):
    for c in candidates:
        if c in cols:
            return c
    lc = {c.lower(): c for c in cols}
    for cand in candidates:
        for low, orig in lc.items():
            if cand in low:
                return orig
    return None


def _parse_prereqs(val):
    if not val:
        return []
    if isinstance(val, (list, tuple)):
        return [str(x).strip() for x in val if str(x).strip()]
    s = str(val).strip()
    if not s or s.lower() in ("none", "null", "-", "0"):
        return []
    try:
        j = json.loads(s)
        if isinstance(j, list):
            return [str(x).strip() for x in j if str(x).strip()]
    except Exception:
        pass
    for sep in (",", "،", ";", "؛", "|"):
        s = s.replace(sep, ",")
    return [x.strip() for x in s.split(",") if x.strip()]


def _max_units(gpa, probation_count: int, risk_level: str):
    reasons = []
    if probation_count >= 2 or (gpa is not None and gpa < 10):
        base = 10
        reasons.append("مشروطی شدید → سقف ۱۰ واحد (آیین‌نامه آموزشی)")
    elif probation_count == 1 or (gpa is not None and gpa < 12):
        base = 14
        reasons.append("مشروطی / معدل زیر ۱۲ → سقف ۱۴ واحد (آیین‌نامه آموزشی)")
    elif gpa is not None and gpa >= 17:
        base = 24
        reasons.append("معدل ≥ ۱۷ (ممتاز) → سقف ۲۴ واحد")
    else:
        base = 20
        reasons.append("وضعیت عادی → سقف ۲۰ واحد")

    if risk_level == "بالا" and base > 12:
        base = 12
        reasons.append("⚠️ ریسک تحصیلی بالا → مسیر محافظه‌کارانه (حداکثر ۱۲ واحد)")
    elif risk_level == "متوسط" and base > 16:
        base = 16
        reasons.append("ریسک متوسط → کاهش سقف به ۱۶ واحد")
    return base, reasons


def build_path(db: Session, student_number: str) -> dict:
    s = db.execute(text(
        "SELECT id, student_number, first_name, last_name, program_id, status "
        "FROM stu_students WHERE student_number = :sn"),
        {"sn": str(student_number)}).mappings().first()
    if not s:
        return {"error": "student not found", "student_number": str(student_number)}

    # risk once - reused for unit cap (the Phase-2 connection!)
    try:
        risk = rs.compute_risk(db, str(student_number))
        risk_level = risk.get("risk_level", "پایین")
        gpa = risk.get("gpa")
        probation = int(risk.get("probation_count") or 0)
    except Exception:
        risk_level, gpa, probation = "پایین", None, 0
    max_units, cap_reasons = _max_units(gpa, probation, risk_level)

    # program
    pcols = _cols(db, "stu_programs")
    ptitle_c = _pick(pcols, ("title", "name"))
    punits_c = _pick(pcols, ("total_units", "units_total", "required_units", "units"))
    program_title, total_required = None, None
    if s["program_id"] is not None and pcols:
        prow = db.execute(text(
            f"SELECT * FROM stu_programs WHERE id = :pid"), {"pid": s["program_id"]}).mappings().first()
        if prow:
            program_title = prow.get(ptitle_c) if ptitle_c else None
            if punits_c:
                total_required = prow.get(punits_c)

    # grades -> passed map (best per course)
    gres = db.execute(text(
        "SELECT term, course_code, course_title, credits, grade, status "
        "FROM stu_grades WHERE student_id = :sid"), {"sid": s["id"]}).mappings().all()
    best = {}
    for g in gres:
        code = str(g["course_code"] or "").strip()
        if not code:
            continue
        cur = best.get(code)
        if cur is None or (g["grade"] or 0) > (cur["grade"] or 0):
            best[code] = dict(g)
    passed = []
    passed_codes = set()
    for code, g in best.items():
        ok = (g["status"] == "passed") or (g["grade"] is not None and g["grade"] >= 10)
        if ok:
            passed_codes.add(code)
            passed.append({"code": code, "title": g["course_title"], "credits": g["credits"],
                           "term": g["term"], "grade": g["grade"]})
    failed_codes = {c for c, g in best.items()
                    if c not in passed_codes and (g["status"] == "failed" or (g["grade"] is not None and g["grade"] < 10))}

    # current enrollments
    eres = db.execute(text(
        "SELECT course_code, course_title, credits FROM stu_enrollments "
        "WHERE student_id = :sid AND status = 'current'"), {"sid": s["id"]}).mappings().all()
    in_progress = [{"code": str(e["course_code"]), "title": e["course_title"],
                    "credits": e["credits"]} for e in eres]
    inprog_codes = {x["code"] for x in in_progress}

    # curriculum (schema-adaptive)
    ccols = _cols(db, "stu_curriculum")
    code_c = _pick(ccols, ("course_code", "code", "unique_code"))
    title_c = _pick(ccols, ("course_title", "title", "name", "course_name"))
    unit_c = _pick(ccols, ("credits", "units", "unit_count", "credit_hours"))
    term_c = _pick(ccols, ("recommended_term", "term_no", "term_number", "term", "semester"))
    pre_c = _pick(ccols, ("prerequisite", "prereq", "prerequisites"))
    prog_c = _pick(ccols, ("program_id",))

    curriculum, cur_codes = [], set()
    if code_c:
        where, params = "", {}
        if prog_c and s["program_id"] is not None:
            where = f"WHERE {prog_c} = :pid"
            params = {"pid": s["program_id"]}
        rows = db.execute(text(f"SELECT * FROM stu_curriculum {where}"), params).mappings().all()
        for r in rows:
            code = str(r.get(code_c) or "").strip()
            if not code:
                continue
            curriculum.append({
                "code": code,
                "title": r.get(title_c) if title_c else code,
                "credits": (r.get(unit_c) or 0) if unit_c else 0,
                "rec_term": r.get(term_c) if term_c else None,
                "prereqs": _parse_prereqs(r.get(pre_c)) if pre_c else [],
            })
            cur_codes.add(code)

    # prereq enrichment: curriculum table has NO prereq column -> pull from
    # offered_courses.prerequisite; map titles->codes when titles are stored.
    try:
        ocols2 = _cols(db, "offered_courses")
        oc_code = _pick(ocols2, ("unique_code", "course_code", "code"))
        oc_pre = _pick(ocols2, ("prerequisite", "prereq"))
        if oc_code and oc_pre:
            premap = {}
            for r2 in db.execute(text(
                    f"SELECT {oc_code} AS oc, {oc_pre} AS op FROM offered_courses")).mappings().all():
                key = str(r2["oc"] or "").strip()
                if key:
                    premap[key] = _parse_prereqs(r2["op"])
            title_to_code = {str(c["title"] or "").strip(): c["code"] for c in curriculum}
            for c in curriculum:
                if not c["prereqs"] and c["code"] in premap:
                    raw = premap[c["code"]]
                    c["prereqs"] = [title_to_code.get(p, p) for p in raw]
    except Exception:
        pass

    if curriculum:
        remaining_rows = [c for c in curriculum
                          if c["code"] not in passed_codes and c["code"] not in inprog_codes]
        extra_passed = [c for c in passed if c["code"] not in cur_codes]
    else:
        # fallback: derive remaining from failed codes only (no curriculum data)
        remaining_rows = [{"code": c, "title": best[c]["course_title"],
                           "credits": best[c]["credits"] or 0, "rec_term": None,
                           "prereqs": []} for c in failed_codes]
        extra_passed = []

    passed_units = sum(int(x["credits"] or 0) for x in passed)
    inprog_units = sum(int(x["credits"] or 0) for x in in_progress)
    remaining_units = sum(int(x["credits"] or 0) for x in remaining_rows)
    cur_total = sum(int(x["credits"] or 0) for x in curriculum) if curriculum else (total_required or 0)
    progress_pct = round(passed_units * 100.0 / cur_total, 1) if cur_total else 0.0

    def tkey(c):
        t = c.get("rec_term")
        if t is not None and str(t).strip() != "":
            try:
                return (0, int(t), c["code"])
            except Exception:
                return (1, str(t), c["code"])
        return (2, 0, c["code"])

    remaining_rows.sort(key=tkey)

    satisfied = set(passed_codes) | inprog_codes
    plan, pending = [], list(remaining_rows)
    term_no, guard = 1, 0
    while pending and guard < 12:
        guard += 1
        avail = [c for c in pending if not (set(c["prereqs"]) - satisfied)]
        if not avail:
            break
        chosen, units, rest = [], 0, []
        for c in avail:
            if units + int(c["credits"] or 0) <= max_units or not chosen:
                chosen.append(c)
                units += int(c["credits"] or 0)
            else:
                rest.append(c)
        if not chosen:
            break
        plan.append({"label": f"ترم پیشنهادی {_fa(term_no)}", "units": units,
                     "courses": [{"code": c["code"], "title": c["title"],
                                  "credits": c["credits"]} for c in chosen]})
        term_no += 1
        satisfied |= {c["code"] for c in chosen}
        planned_codes = {c["code"] for c in chosen}
        pending = rest + [c for c in pending if c["code"] not in planned_codes
                          and (set(c["prereqs"]) - satisfied)]

    blocked = []
    for c in pending:
        missing = sorted(set(c["prereqs"]) - satisfied)
        if missing:
            blocked.append({"code": c["code"], "title": c["title"],
                            "missing_prereqs": missing})
    pending_unscheduled = [c["code"] for c in pending
                           if not (set(c["prereqs"]) - satisfied)]

    out = {
        "student_number": s["student_number"],
        "student_name": ((s["first_name"] or "") + " " + (s["last_name"] or "")).strip(),
        "program": program_title,
        "risk_level": risk_level,
        "max_units_next_term": {"value": max_units, "reasons": cap_reasons},
        "summary": {"passed_units": passed_units, "in_progress_units": inprog_units,
                    "remaining_units": remaining_units, "total_required": cur_total or total_required,
                    "progress_pct": progress_pct},
        "plan": plan,
        "available_now_count": sum(1 for c in remaining_rows
                                   if not (set(c["prereqs"]) - (set(passed_codes) | inprog_codes))),
        "blocked": blocked,
        "pending_unscheduled": pending_unscheduled,
        "extra_passed_count": len(extra_passed),
        "detail": {"passed": passed, "in_progress": in_progress,
                   "remaining": [{"code": c["code"], "title": c["title"],
                                  "credits": c["credits"], "prereqs": c["prereqs"]}
                                 for c in remaining_rows]},
        "disclaimer": DISCLAIMER,
    }
    try:
        ets.track_event(db, event_type="studypath_viewed", event_name="me",
                        student_ref=str(student_number), source="api",
                        payload={"plan_terms": len(plan), "risk_level": risk_level})
    except Exception:
        pass
    return out

